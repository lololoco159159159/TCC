# Conexão com o Neo4j (N1 — ESTADO_ATUAL.md §4.5; decisão D14).
# Copie este arquivo para .env.local (ignorado pelo git) e preencha a senha.
# As variáveis NÃO têm o prefixo VITE_ de propósito: ficam só no servidor do
# Vite (proxy /api/cypher) e nunca entram no código enviado ao navegador.
NEO4J_URL=http://localhost:7474
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=
