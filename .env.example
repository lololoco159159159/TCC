# Configuração local do projeto. Copie este arquivo para .env.local (ignorado
# pelo git) e preencha a senha do Neo4j.

# Conexão com o Neo4j — usada só pela API (pasta api/); a senha nunca chega ao
# navegador.
NEO4J_URL=http://localhost:7474
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Endereço da API, para onde o site repassa os pedidos /api/ (opcional; o
# padrão é este).
# API_URL=http://localhost:8000
